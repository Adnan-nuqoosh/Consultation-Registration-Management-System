{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "adnan-nuqoosh/consultation-registration-management-system",
  "type": "project",
  "description": "Consultation registration and administration API.",
  "license": "proprietary",
  "require": {"php": "^8.3", "laravel/framework": "^13.0", "laravel/sanctum": "^4.0"},
  "require-dev": {"mockery/mockery": "^1.6", "phpunit/phpunit": "^12.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": ["@php vendor/bin/phpunit"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}